{
  "name": "minibook-monorepo",
  "private": true,
  "version": "0.2.7",
  "description": "MiniBook (Books) — minimalist cross-platform Ebook Reader (.epub, .azw3/KF8, .mobi, .fb2, .txt, .md) with Read Aloud (TTS) and Android E-Ink Mode. 100% TypeScript core, zero native Node addons.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "check:native": "node scripts/check-native-deps.mjs",
    "dev": "pnpm --filter @minibook/host-node dev",
    "dev:node": "pnpm --filter @minibook/host-node dev",
    "dev:ui": "pnpm --filter @minibook/ui dev",
    "start": "pnpm --filter @minibook/host-node start",
    "start:app": "pnpm --filter @minibook/host-node start:app",
    "start:node": "pnpm --filter @minibook/host-node start",
    "bump:version": "node scripts/bump-version.mjs",
    "build:apk": "pnpm --filter @minibook/host-android build:apk",
    "build:apk:ci": "pnpm --filter @minibook/host-android build:apk:ci"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "~22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
